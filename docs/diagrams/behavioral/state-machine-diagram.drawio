ace=wrap;" vertex="1" parent="1"><mxGeometry x="296" y="128" width="260" height="34" as="geometry"/></mxCell><mxCell id="c8" value="" style="endArrow=open;endSize=10;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;align=left;" edge="1" parent="1" source="sc" target="srej"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="[else] / respond 403 or 409,&lt;br&gt;no submission row created" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="278" y="250" width="200" height="34" as="geometry"/></mxCell><mxCell id="c10" value="" style="endArrow=open;endSize=10;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;align=left;edgeStyle=orthogonalEdgeStyle;exitX=0.25;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="q" target="r"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="dequeue&lt;br&gt;[sandbox slot free]" style="text;html=1;fontSize=11;align=right;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="430" y="275" width="120" height="34" as="geometry"/></mxCell><mxCell id="c12" value="" style="endArrow=open;endSize=10;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;align=left;edgeStyle=orthogonalEdgeStyle;exitX=0.75;exitY=0;entryX=0.75;entryY=1;" edge="1" parent="1" source="r" target="q"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="sandbox_error [retry_count &amp;lt; 3]&lt;br&gt;/ retry_count += 1" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="791" y="275" width="200" height="34" as="geometry"/></mxCell><mxCell id="c14" value="" style="endArrow=open;endSize=10;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;align=left;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="r" target="f"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="sandbox_error&lt;br&gt;[retry_count ≥ 3]" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="900" y="380" width="140" height="34" as="geometry"/></mxCell><mxCell id="c16" value="" style="endArrow=open;endSize=10;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;align=left;" edge="1" parent="1" source="r" target="te"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="tests_finished [all test cases evaluated]&lt;br&gt;(timeout / runtime error stored as error_type)" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="716" y="530" width="260" height="34" as="geometry"/></mxCell><mxCell id="c18" value="" style="endArrow=open;endSize=10;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;align=left;edgeStyle=orthogonalEdgeStyle;exitX=0.1;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="1" source="te" target="fr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="ai_response&lt;br&gt;[valid ∧ confidence ≥ 0.7]&lt;br&gt;/ source := ai" style="text;html=1;fontSize=11;align=right;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="380" y="770" width="180" height="50" as="geometry"/></mxCell><mxCell id="c20" value="" style="endArrow=open;endSize=10;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;align=left;edgeStyle=orthogonalEdgeStyle;exitX=0.9;exitY=1;entryX=0.8;entryY=0;" edge="1" parent="1" source="te" target="fr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="ai_error ∨ [confidence &amp;lt; 0.7]&lt;br&gt;/ source := fallback" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="836" y="778" width="200" height="34" as="geometry"/></mxCell><mxCell id="c22" value="" style="endArro