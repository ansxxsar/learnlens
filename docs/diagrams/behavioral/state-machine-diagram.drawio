<mxfile host="app.diagrams.net"><diagram id="learnlens-state" name="State Machine Diagrams"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="LearnLens – State Machine Diagrams" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="800" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Transition syntax: event [guard] / action · Submission statuses match the ERD enum (queued · running · tested · feedback_ready · failed)" style="text;html=1;fontSize=12;fontColor=#666666;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1200" height="22" as="geometry"/></mxCell><mxCell id="c3" value="sm Submission (attempt lifecycle)" style="shape=umlFrame;whiteSpace=wrap;html=1;width=260;height=28;fontStyle=1;align=left;spacingLeft=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1110" height="1130" as="geometry"/></mxCell><mxCell id="s0" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="70" y="160" width="26" height="26" as="geometry"/></mxCell><mxCell id="sc" value="" style="rhombus;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="250" y="155" width="36" height="36" as="geometry"/></mxCell><mxCell id="srej" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="254" y="360" width="28" height="28" as="geometry"/></mxCell><mxCell id="q" value="&lt;div style='text-align:center;font-size:13px'&gt;&lt;b&gt;Queued&lt;/b&gt;&lt;/div&gt;&lt;hr style='margin:3px 0'&gt;&lt;div style='font-size:11px'&gt;entry / attempt_number := prev + 1&lt;br&gt;entry / store files as immutable snapshot&lt;br&gt;do / wait in Redis queue&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="560" y="120" width="300" height="100" as="geometry"/></mxCell><mxCell id="r" value="&lt;div style='text-align:center;font-size:13px'&gt;&lt;b&gt;Running&lt;/b&gt;&lt;/div&gt;&lt;hr style='margin:3px 0'&gt;&lt;div style='font-size:11px'&gt;entry / status := running; started_at := now&lt;br&gt;do / execute tests in Docker sandbox&lt;br&gt;(cpu ≤ 1, mem ≤ 256 MB, no network)&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="560" y="370" width="300" height="104" as="geometry"/></mxCell><mxCell id="f" value="&lt;div style='text-align:center;font-size:13px'&gt;&lt;b&gt;Failed&lt;/b&gt;&lt;/div&gt;&lt;hr style='margin:3px 0'&gt;&lt;div style='font-size:11px'&gt;entry / status := failed&lt;br&gt;entry / write audit_log&lt;br&gt;entry / notify student&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="920" y="580" width="200" height="96" as="geometry"/></mxCell><mxCell id="te" value="&lt;div style='text-align:center;font-size:13px'&gt;&lt;b&gt;Tested&lt;/b&gt;&lt;/div&gt;&lt;hr style='margin:3px 0'&gt;&lt;div style='font-size:11px'&gt;entry / save test_results, criterion_scores&lt;br&gt;do / request AI feedback (timeout 20 s)&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="560" y="620" width="300" height="90" as="geometry"/></mxCell><mxCell id="fr" value="&lt;div style='t