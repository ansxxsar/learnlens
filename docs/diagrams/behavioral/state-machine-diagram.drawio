pdate fields&lt;/i&gt;&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1400" y="125" width="230" height="74" as="geometry"/></mxCell><mxCell id="ap" value="&lt;div style='text-align:center;font-size:13px'&gt;&lt;b&gt;Published&lt;/b&gt;&lt;/div&gt;&lt;hr style='margin:3px 0'&gt;&lt;div style='font-size:11px'&gt;entry / published_at := now&lt;br&gt;do / accept submissions&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1400" y="320" width="230" height="74" as="geometry"/></mxCell><mxCell id="ac" value="&lt;div style='text-align:center;font-size:13px'&gt;&lt;b&gt;Closed&lt;/b&gt;&lt;/div&gt;&lt;hr style='margin:3px 0'&gt;&lt;div style='font-size:11px'&gt;entry / reject new submissions&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1400" y="510" width="230" height="60" as="geometry"/></mxCell><mxCell id="aa" value="&lt;div style='text-align:center;font-size:13px'&gt;&lt;b&gt;Archived&lt;/b&gt;&lt;/div&gt;&lt;hr style='margin:3px 0'&gt;&lt;div style='font-size:11px'&gt;read-only, hidden from students&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1760" y="510" width="200" height="60" as="geometry"/></mxCell><mxCell id="af" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1846" y="630" width="28" height="28" as="geometry"/></mxCell><mxCell id="c28" value="" style="endArrow=open;endSize=10;html=1;rounded=