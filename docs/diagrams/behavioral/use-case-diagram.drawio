<mxfile host="app.diagrams.net"><diagram id="learnlens-usecase" name="Use Case Diagram"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="LearnLens – Use Case Diagram (MVP)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="800" height="36" as="geometry"/></mxCell><mxCell id="c2" value="PED 741 · Assignment 3 · UML 2.5 · «include» = always performed · «extend» = conditional, at an extension point" style="text;html=1;fontSize=12;fontColor=#666666;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="900" height="22" as="geometry"/></mxCell><mxCell id="boundary" value="&lt;b&gt;LearnLens Platform&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#666666;verticalAlign=top;align=center;fontSize=15;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="230" y="100" width="1020" height="1040" as="geometry"/></mxCell><mxCell id="user" value="User &lt;span style='font-weight:normal;font-size:11px'&gt;(abstract)&lt;/span&gt;" style="shape=umlActor;verticalLabelPosition=top;verticalAlign=bottom;html=1;outlineConnect=0;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="95" y="150" width="30" height="60" as="geometry"/></mxCell><mxCell id="student" value="Student" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="390" width="30" height="60" as="geometry"/></mxCell><mxCell id="instructor" value="Instructor" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="880" width="30" height="60" as="geometry"/></mxCell><mxCell id="sandbox" value="«system»&lt;br&gt;Code Execution&lt;br&gt;Sandbox" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1330" y="300" width="30" height="60" as="geometry"/></mxCell><mxCell id="ai" value="«system»&lt;br&gt;AI Feedback&lt;br&gt;Service" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1330" y="430" width="30" height="60" as="geometry"/></mxCell><mxCell id="admin" value="Administrator" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1330" y="790" width="30" height="60" as="geometry"/></mxCell><mxCell id="uc01" value="&lt;span style='font-size:10px;color:#555'&gt;UC-01&lt;/span&gt;&lt;br&gt;&lt;b&gt;Sign In&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="140" width="220" height="64" as="geometry"/></mxCell><mxCell id="uc02" value="&lt;span style='font-size:10px;color:#555'&gt;UC-02&lt;/span&gt;&lt;br&gt;&lt;b&gt;Submit Code Attempt&lt;/b&gt;&lt;hr style='margin:3px 0'&gt;&lt;span style='font-size:9px'&gt;extension point:&lt;br&gt;attempt completed&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="270" width="220" height="84" as="geometry"/></mxCell><mxCell id="uc06" value="&lt;span style='font-size:10px;color:#555'&gt;UC-06&lt;/span&gt;&lt;br&gt;&lt;b&gt;View Attempt History&lt;/b&gt;&lt;hr style='margin:3px 0'&gt;&lt;span style='font-size:9px'&gt;extension point:&lt;br&gt;two or more attempts&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="520" width="220" height="84" as="geometry"/></mxCell><mxCell id="uc07" value="&lt;span style='font-size:10px;color:#555'&gt;UC-07&lt;/span&gt;&lt;br&gt;&lt;b&gt;View Progress Dashboard&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="680" width="220" height="64" as="geometry"/></mxCell><mxCell id="uc_v" value="&lt;span style='font-size:10px;color:#555'&gt;UC-08&lt;/span&gt;&lt;br&gt;&lt;b&gt;Verify Enrollment &amp;amp; Deadline&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="150" width="220" height="64" as="geometry"/></mxCell><mxCell id="uc03" value="&lt;span style='font-size:10px;color:#555'&gt;UC-03&lt;/span&gt;&lt;br&gt;&lt;b&gt;Execute Tests in Sandbox&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="260" width="220" height="64" as="geometry"/></mxCell><mxCell id="uc04" value="&lt;span style='font-size:10px;color:#555'&gt;UC-04&lt;/span&gt;&lt;br&gt;&lt;b&gt;Generate Rubric-Aligned Feedback&lt;/b&gt;&lt;hr style='margin:3px 0'&gt;&lt;span style='font-size:9px'&gt;extension point:&lt;br&gt;AI unavailable / low confidence&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="365" width="220" height="84" as="geometry"/></mxCell><mxCell id="uc05" value="&lt;span style='font-size:10px;color:#555'&gt;UC-05&lt;/span&gt;&lt;br&gt;&lt;b&gt;Answer Reinforcement Question&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="495" width="220" height="64" as="geometry"/></mxCell><mxCell id="uc16" value="&lt;span style='font-size:10px;color:#555'&gt;UC-09&lt;/span&gt;&lt;br&gt;&lt;b&gt;Compare Attempts&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="610" width="220" height="64" as="geometry"/></mxCell><mxCell id="uc15" value="&lt;span style='font-size:10px;color:#555'&gt;UC-10&lt;/span&gt;&lt;br&gt;&lt;b&gt;Use Test-Only Fallback Feedback&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="500" width="220" height="64" as="geometry"/></mxCell><mxCell id="uc09" value="&lt;span style='font-size:10px;color:#555'&gt;UC-11&lt;/span&gt;&lt;br&gt;&lt;b&gt;Create &amp;amp; Publish Assignment&lt;/b&gt;&lt;hr style='margin:3px 0'&gt;&lt;span style='font-size:9px'&gt;extension point:&lt;br&gt;before publishing&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="800" width="220" height="84" as="geometry"/></mxCell><mxCell id="uc10" value="&lt;span style='font-size:10px;color:#555'&gt;UC-12&lt;/span&gt;&lt;br&gt;&lt;b&gt;Configure Rubric &amp;amp; Test Cases&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="755" width="220" height="64" as="geometry"/></mxCell><mxCell id="uc11" value="&lt;span style='font-size:10px;color:#555'&gt;UC-13&lt;/span&gt;&lt;br&gt;&lt;b&gt;Preview as Student&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="860" width="220" height="64" as="geometry"/></mxCell><mxCell id="uc12" value="&lt;span style='font-size:10px;color:#555'&gt;UC-14&lt;/span&gt;&lt;br&gt;&lt;b&gt;Review Submission&lt;/b&gt;&lt;hr style='margin:3px 0'&gt;&lt;span style='font-size:9px'&gt;extension point:&lt;br&gt;result disputed&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="940" width="220" height="84" as="geometry"/></mxCell><mxCell id="uc13" value="&lt;span style='font-size:10px;color:#555'&gt;UC-15&lt;/span&gt;&lt;br&gt;&lt;b&gt;Override Automated Score&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="975" width="220" height="64" as="geometry"/></mxCell><mxCell id="uc17" value="&lt;span style='font-size:10px;color:#555'&gt;UC-16&lt;/span&gt;&lt;br&gt;&lt;b&gt;Record Audit Log Entry&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="975" width="220" height="64" as="geometry"/></mxCell><mxCell id="uc14" value="&lt;span style='font-size:10px;color:#555'&gt;UC-17&lt;/span&gt;&lt;br&gt;&lt;b&gt;View Cohort Analytics&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="1060" width="220" height="64" as="geometry"/></mxCell><mxCell id="uc18" value="&lt;span style='font-size:10px;color:#555'&gt;UC-18&lt;/span&gt;&lt;br&gt;&lt;b&gt;Manage Courses, Sections &amp;amp; Enrollments&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="785" width="220" height="64" as="geometry"/></mxCell><mxCell id="c3" value="" style="endArrow=block;endFill=0;endSize=14;html=1;" edge="1" parent="1" source="student" target="user"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c4" value="" style="endArrow=block;endFill=0;endSize=14;html=1;" edge="1" parent="1" source="instructor" target="user"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="40" y="600"/><mxPoint x="40" y="240"/></Array></m