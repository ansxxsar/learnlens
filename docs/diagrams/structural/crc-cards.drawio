<mxfile host="app.diagrams.net"><diagram id="learnlens-crc" name="CRC Cards"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="LearnLens – CRC Cards (Class · Responsibilities · Collaborators)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1000" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Each card has exactly one reason to change (Single Responsibility Principle). Colour = layer: blue domain · purple service · orange infrastructure." style="text;html=1;fontSize=12;fontColor=#666666;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1200" height="22" as="geometry"/></mxCell><mxCell id="c3" value="&lt;table style='width:100%;height:100%;border-collapse:collapse;font-size:11px' cellpadding='4'&gt;&lt;tr&gt;&lt;td colspan='2' style='background:#dae8fc;border-bottom:1px solid #6c8ebf;text-align:center'&gt;&lt;b style='font-size:13px'&gt;User&lt;/b&gt; &lt;span style='font-size:10px;color:#555'&gt;«domain»&lt;/span&gt;&lt;br&gt;&lt;i style='font-size:10px'&gt;SRP: Represent one person's identity&lt;/i&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:64%;vertical-align:top;border-right:1px solid #6c8ebf'&gt;&lt;b&gt;Responsibilities&lt;/b&gt;&lt;ul style='margin:2px 0 0 0;padding-left:14px'&gt;&lt;li&gt;Store email, full name, active flag&lt;/li&gt;&lt;li&gt;Store password only as a hash&lt;/li&gt;&lt;li&gt;Verify a raw password against the hash&lt;/li&gt;&lt;/ul&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;b&gt;Collaborators&lt;/b&gt;&lt;br&gt;Enrollment&lt;br&gt;AuthService&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="html=1;whiteSpace=wrap;overflow=fill;verticalAlign=top;align=left;spacing=0;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="400" height="168" as="geometry"/></mxCell><mxCell id="c4" value="&lt;table style='width:100%;height:100%;border-collapse:collapse;font-size:11px' cellpadding='4'&gt;&lt;tr&gt;&lt;td colspan='2' style='background:#e1d5e7;border-bottom:1px solid #9673a6;text-align:center'&gt;&lt;b style='font-size:13px'&gt;AuthService&lt;/b&gt; &lt;span style='font-size:10px;color:#555'&gt;«service»&lt;/span&gt;&lt;br&gt;&lt;i style='font-size:10px'&gt;SRP: Manage sign-in sessions&lt;/i&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:64%;vertical-align:top;border-right:1px solid #9673a6'&gt;&lt;b&gt;Responsibilities&lt;/b&gt;&lt;ul style='margin:2px 0 0 0;padding-left:14px'&gt;&lt;li&gt;Authenticate email + password&lt;/li&gt;&lt;li&gt;Issue and invalidate server sessions&lt;/li&gt;&lt;li&gt;Lock account after 5 failed attempts&lt;/li&gt;&lt;/ul&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;b&gt;Collaborators&lt;/b&gt;&lt;br&gt;User&lt;br&gt;AuditLogger&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="html=1;whiteSpace=wrap;overflow=fill;verticalAlign=top;align=left;spacing=0;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;shadow=1;" vertex="1" parent="1"><mxGeometry x="470" y="90" width="400" height="168" as="geometry"/></mxCell><mxCell id="c5" value="&lt;table style='width:100%;height:100%;border-collapse:collapse;font-size:11px' cellpadding='4'&gt;&lt;tr&gt;&lt;td colspan='2' style='background:#dae8fc;border-bottom:1px solid #6c8ebf;text-align:center'&gt;&lt;b style='font-size:13px'&gt;Enrollment&lt;/b&gt; &lt;span style='font-size:10px;color:#555'&gt;«domain»&lt;/span&gt;&lt;br&gt;&lt;i style='font-size:10px'&gt;SRP: Link a user to a course with a role&lt;/i&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:64%;vertical-align:top;border-right:1px solid #6c8ebf'&gt;&lt;b&gt;Responsibilities&lt;/b&gt;&lt;ul style='margin:2px 0 0 0;padding-left:14px'&gt;&lt;li&gt;Know the user's role (student / instructor)&lt;/li&gt;&lt;li&gt;Know the optional section (e.g. “02 P”)&lt;/li&gt;&lt;li&gt;Ensure section belongs to the same course&lt;/li&gt;&lt;/ul&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;b&gt;Collaborators&lt;/b&gt;&lt;br&gt;User&lt;br&gt;Course&lt;br&gt;CourseSection&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="html=1;whiteSpace=wrap;overflow=fill;verticalAlign=top;align=left;spacing=0;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;shadow=1;" vertex="1" parent="1"><mxGeometry x="900" y="90" width="400" height="168" as="geometry"/></mxCell><mxCell id="c6" value="&lt;table style='width:100%;height:100%;border-collapse:collapse;font-size:11px' cellpadding='4'&gt;&lt;tr&gt;&lt;td colspan='2' style='background:#dae8fc;border-bottom:1px solid #6c8ebf;text-align:center'&gt;&lt;b style='font-size:13px'&gt;Course&lt;/b&gt; &lt;span style='font-size:10px;color:#555'&gt;«domain»&lt;/span&gt;&lt;br&gt;&lt;i style='font-size:10px'&gt;SRP: Represent a course offering&lt;/i&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:64%;vertical-align:top;border-right:1px solid #6c8ebf'&gt;&lt;b&gt;Responsibilities&lt;/b&gt;&lt;ul style='margin:2px 0 0 0;padding-left:14px'&gt;&lt;li&gt;Know code, title and term&lt;/li&gt;&lt;li&gt;Own its sections, skills and assignments&lt;/li&gt;&lt;/ul&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;b&gt;Collaborators&lt;/b&gt;&lt;br&gt;CourseSection&lt;br&gt;Assignment&lt;br&gt;Skill&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="html=1;whiteSpace=wrap;overflow=fill;verticalAlign=top;align=left;spacing=0;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;shadow=1;" vertex="1" parent="1"><mxGeometry x="1330" y="90" width="400" height="168" as="geometry"/></mxCell><mxCell id="c7" value="&lt;table style='width:100%;height:100%;border-collapse:collapse;font-size:11px' cellpadding='4'&gt;&lt;tr&gt;&lt;td colspan='2' style='background:#dae8fc;border-bottom:1px solid #6c8ebf;text-align:center'&gt;&lt;b style='font-size:13px'&gt;Assignment&lt;/b&gt; &lt;span style='font-size:10px;color:#555'&gt;«domain»&lt;/span&gt;&lt;br&gt;&lt;i style='font-size:10px'&gt;SRP: Define one programming task and its lifecycle&lt;/i&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:64%;vertical-align:top;border-right:1px solid #6c8ebf'&gt;&lt;b&gt;Responsibilities&lt;/b&gt;&lt;ul style='margin:2px 0 0 0;padding-left:14px'&gt;&lt;li&gt;Know instructions, due date, feedback depth&lt;/li&gt;&lt;li&gt;Move Draft → Published → Closed → Archived&lt;/li&gt;&lt;li&gt;Answer “accepts submissions now?”&lt;/li&gt;&lt;/ul&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;b&gt;Collaborators&lt;/b&gt;&lt;br&gt;Course&lt;br&gt;RubricCriterion&lt;br&gt;TestCase&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="html=1;whiteSpace=wrap;overflow=fill;verticalAlign=top;align=left;spacing=0;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="284" width="400" height="168" as="geometry"/></mxCell><mxCell id="c8" value="&lt;table style='width:100%;height:100%;border-collapse:collapse;font-size:11px' cellpadding='4'&gt;&lt;tr&gt;&lt;td colspan='2' style='background:#dae8fc;border-bottom:1px solid #6c8ebf;text-align:center'&gt;&lt;b style='font-size:13px'&gt;RubricCriterion&lt;/b&gt; &lt;span style='font-size:10px;color:#555'&gt;«domain»&lt;/span&gt;&lt;br&gt;&lt;i style='font-size:10px'&gt;SRP: Define one scored criterion&lt;/i&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:64%;vertical-align:top;border-right:1px solid #6c8ebf'&gt;&lt;b&gt;Responsibilities&lt;/b&gt;&lt;ul style='margin:2px 0 0 0;padding-left:14px'&gt;&lt;li&gt;Know title, description, max points, order&lt;/li&gt;&lt;li&gt;Link the criterion to a skill&lt;/li&gt;&lt;/ul&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;b&gt;Collaborators&lt;/b&gt;&lt;br&gt;Assignment&lt;br&gt;Skill&lt;br&gt;CriterionScore&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="html=1;whiteSpace=wrap;overflow=fill;verticalAlign=top;align=left;spacing=0;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;shadow=1;" vertex="1" parent="1"><mxGeometry x="470" y="284" width="400" height="168" as="geometry"/></mxCell><mxCell id="c9" value="&lt;table style='width:100%;height:100%;border-collapse:collapse;font-size:11px' cellpadding='4'&gt;&lt;tr&gt;&lt;td colspan='2' style='background:#dae8fc;border-bottom:1px solid #6c8ebf;text-align:center'&gt;&lt;b style='font-size:13px'&gt;TestCase&lt;/b&gt; &lt;span style='font-size:10px;color:#555'&gt;«domain»&lt;/span&gt;&lt;br&gt;&lt;i style='font-size:10px'&gt;SRP: Define one automated check&lt;/i&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:64%;vertical-align:top;border-right:1px solid #6c8ebf'&gt;&lt;b&gt;Responsibilities&lt;/b&gt;&lt;ul style='margin:2px 0 0 0;padding-left:14px'&gt;&lt;li&gt;Store stdin input, expected output, weight, time limit&lt;/li&gt;&lt;li&gt;Hide itself from students when hidden&lt;/li&gt;&lt;li&gt;Compare an actual output with the expected one&lt;/li&gt;&lt;/ul&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;b&gt;Collaborators&lt;/b&gt;&lt;br&gt;Assignment&lt;br&gt;RubricCriterion&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="html=1;whiteSpace=wrap;overflow=fill;verticalAlign=top;align=left;spacing=0;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;shadow=1;" vertex="1" parent="1"><mxGeometry x="900" y="284" width="400" height="168" as="geometry"/></mxCell><mxCell id="c10" value="&lt;table style='width:100%;height:100%;border-collapse:collapse;font-size:11px' cellpadding='4'&gt;&lt;tr&gt;&lt;td colspan='2' style='background:#dae8fc;border-bottom:1px solid #6c8ebf;text-align:center'&gt;&lt;b style='font-size:13px'&gt;Submission&lt;/b&gt; &lt;span style='font-size:10px;color:#555'&gt;«domain»&lt;/span&gt;&lt;br&gt;&lt;i style='font-size:10px'&gt;SRP: Record one immutable attempt&lt;/i&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:64%;vertical-align:top;border-right:1px solid #6c8ebf'&gt;&lt;b&gt;Responsibilities&lt;/b&gt;&lt;ul style='margin:2px 0 0 0;padding-left:14px'&gt;&lt;li&gt;Know attempt number, language, files, time&lt;/li&gt;&lt;li&gt;Track status: queued → running → tested → feedback_ready / failed&lt;/li&gt;&lt;/ul&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;b&gt;Collaborators&lt;/b&gt;&lt;br&gt;Assignment&lt;br&gt;User&lt;br&gt;SubmissionFile&lt;br&gt;TestResult&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="html=1;whiteSpace=wrap;overflow=fill;verticalAlign=top;align=left;spacing=0;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;shadow=1;" vertex="1" parent="1"><mxGeometry x="1330" y="284" width="400" height="168" as="geometry"/></mxCell><mxCell id="c11" value="&lt;table style='width:100%;height:100%;border-collapse:collapse;font-size:11px' cellpadding='4'&gt;&lt;tr&gt;&lt;td colspan='2' style='background:#e1d5e7;border-bottom:1px solid #9673a6;text-align:center'&gt;&lt;b style='font-size:13px'&gt;SubmissionService&lt;/b&gt; &lt;span style='font-size:10px;color:#555'&gt;«service»&lt;/span&gt;&lt;br&gt;&lt;i style='font-size:10px'&gt;SRP: Accept a new attempt&lt;/i&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:64%;vertical-align:top;border-right:1px solid #9673a6'&gt;&lt;b&gt;Responsibilities&lt;/b&gt;&lt;ul style='margin:2px 0 0 0;padding-left:14px'&gt;&lt;li&gt;Check enrollment, publish status and deadline&lt;/li&gt;&lt;li&gt;Create the Submission and its files&lt;/li&gt;&lt;li&gt;Enqueue the grading job&lt;/li&gt;&lt;/ul&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;b&gt;Collaborators&lt;/b&gt;&lt;br&gt;Enrollment&lt;br&gt;Assignment&lt;br&gt;Submission&lt;br&gt;GradingWorker&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="html=1;whiteSpace=wrap;overflow=fill;verticalAlign=top;align=left;spacing=0;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="478" width="400" height="168" as="geometry"/></mxCell><mxCell id="c12" value="&lt;table style='width:100%;height:100%;border-collapse:collapse;font-size:11px' cellpadding='4'&gt;&lt;tr&gt;&lt;td colspan='2' style='background:#ffe6cc;border-bottom:1px solid #d79b00;text-align:center'&gt;&lt;b style='font-size:13px'&gt;SandboxRunner&lt;/b&gt; &lt;span style='font-size:10px;color:#555'&gt;«infrastructure»&lt;/span&gt;&lt;br&gt;&lt;i style='font-size:10px'&gt;SRP: Execute untrusted code safely&lt;/i&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:64%;vertical-align:top;border-right:1px solid #d79b00'&gt;&lt;b&gt;Responsibilities&lt;/b&gt;&lt;ul style='margin:2px 0 0 0;padding-left:14px'&gt;&lt;li&gt;Run code in an isolated container&lt;/li&gt;&lt;li&gt;Enforce CPU, memory, time and no-network limits&lt;/li&gt;&lt;li&gt;Return raw output and error type&lt;/li&gt;&lt;/ul&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;b&gt;Collaborators&lt;/b&gt;&lt;br&gt;Submission&lt;br&gt;TestCase&lt;br&gt;TestResult&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="html=1;whiteSpace=wrap;overflow=fill;verticalAlign=top;align=left;spacing=0;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1.5;shadow=1;" vertex="1" parent="1"><mxGeometry x="470" y="478" width="400" height="168" as="geometry"/></mxCell><mxCell id="c13" value="&lt;table style='width:100%;height:100%;border-collapse:collapse;font-size:11px' cellpadding='4'&gt;&lt;tr&gt;&lt;td colspan='2' style='background:#e1d5e7;border-bottom:1px solid #9673a6;text-align:center'&gt;&lt;b style='font-size:13px'&gt;GradingWorker&lt;/b&gt; &lt;span style='font-size:10px;color:#555'&gt;«service»&lt;/span&gt;&lt;br&gt;&lt;i style='font-size:10px'&gt;SRP: Orchestrate grading of one attempt&lt;/i&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:64%;vertical-align:top;border-right:1px solid #9673a6'&gt;&lt;b&gt;Responsibilities&lt;/b&gt;&lt;ul style='margin:2px 0 0 0;padding-left:14px'&gt;&lt;li&gt;Call SandboxRunner for every test case&lt;/li&gt;&lt;li&gt;Calculate criterion auto points&lt;/li&gt;&lt;li&gt;Trigger feedback and progress updates&lt;/li&gt;&lt;/ul&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;b&gt;Collaborators&lt;/b&gt;&lt;br&gt;SandboxRunner&lt;br&gt;CriterionScore&lt;br&gt;FeedbackService&lt;br&gt;ProgressService&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="html=1;whiteSpace=wrap;overflow=fill;verticalAlign=top;align=left;spacing=0;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;shadow=1;" vertex="1" parent="1"><mxGeometry x="900" y="478" width="400" height="168" as="geometry"/></mxCell><mxCell id="c14" value="&lt;table style='width:100%;height:100%;border-collapse:collapse;font-size:11px' cellpadding='4'&gt;&lt;tr&gt;&lt;td colspan='2' style='background:#e1d5e7;border-bottom:1px solid #9673a6;text-align:center'&gt;&lt;b style='font-size:13px'&gt;FeedbackService&lt;/b&gt; &lt;span style='font-size:10px;color:#555'&gt;«service»&lt;/span&gt;&lt;br&gt;&lt;i style='font-size:10px'&gt;SRP: Turn evidence into feedback&lt;/i&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:64%;vertical-align:top;border-right:1px solid #9673a6'&gt;&lt;b&gt;Responsibilities&lt;/b&gt;&lt;ul style='margin:2px 0 0 0;padding-left:14px'&gt;&lt;li&gt;Build prompt from rubric + public evidence only&lt;/li&gt;&lt;li&gt;Validate LLM response and confidence&lt;/li&gt;&lt;li&gt;Fall back to test-only feedback on failure&lt;/li&gt;&lt;/ul&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;b&gt;Collaborators&lt;/b&gt;&lt;br&gt;LLMClient&lt;br&gt;Feedback&lt;br&gt;TestResult&lt;br&gt;RubricCriterion&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="html=1;whiteSpace=wrap;overflow=fill;verticalAlign=top;align=left;spacing=0;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;shadow=1;" vertex="1" parent="1"><mxGeometry x="1330" y="478" width="400" height="168" as="geometry"/></mxCell><mxCell id="c15" value="&lt;table style='width:100%;height:100%;border-collapse:collapse;font-size:11px' cellpadding='4'&gt;&lt;tr&gt;&lt;td colspan='2' style='background:#dae8fc;border-bottom:1px solid #6c8ebf;text-align:center'&gt;&lt;b style='font-size:13px'&gt;Feedback&lt;/b&gt; &lt;span style='font-size:10px;color:#555'&gt;«domain»&lt;/span&gt;&lt;br&gt;&lt;i style='font-size:10px'&gt;SRP: Hold the feedback for one attempt&lt;/i&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:64%;vertical-align:top;border-right:1px solid #6c8ebf'&gt;&lt;b&gt;Responsibilities&lt;/b&gt;&lt;ul style='margin:2px 0 0 0;padding-left:14px'&gt;&lt;li&gt;Know source (ai / fallback), model, prompt version&lt;/li&gt;&lt;li&gt;Group strengths, issues and next steps (items)&lt;/li&gt;&lt;/ul&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;b&gt;Collaborators&lt;/b&gt;&lt;br&gt;Submission&lt;br&gt;FeedbackItem&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="html=1;whiteSpace=wrap;overflow=fill;verticalAlign=top;align=left;spacing=0;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="672" width="400" height="168" as="geometry"/></mxCell><mxCell id="c16" value="&lt;table style='width:100%;height:100%;border-collapse:collapse;font-size:11px' cellpadding='4'&gt;&lt;tr&gt;&lt;td colspan='2' style='background:#dae8fc;border-bottom:1px solid #6c8ebf;text-align:center'&gt;&lt;b style='font-size:13px'&gt;ReinforcementQuestion&lt;/b&gt; &lt;span style='font-size:10px;color:#555'&gt;«domain»&lt;/span&gt;&lt;br&gt;&lt;i style='font-size:10px'&gt;SRP: Check understanding after an attempt&lt;/i&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:64%;vertical-align:top;border-right:1px solid #6c8ebf'&gt;&lt;b&gt;Responsibilities&lt;/b&gt;&lt;ul style='margin:2px 0 0 0;padding-left:14px'&gt;&lt;li&gt;Store prompt, options and explanation&lt;/li&gt;&lt;li&gt;Check the selected answer (not graded)&lt;/li&gt;&lt;/ul&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;b&gt;Collaborators&lt;/b&gt;&lt;br&gt;Submission&lt;br&gt;Skill&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="html=1;whiteSpace=wrap;overflow=fill;verticalAlign=top;align=left;spacing=0;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;shadow=1;" vertex="1" parent="1"><mxGeometry x="470" y="672" width="400" height="168" as="geometry"/></mxCell><mxCell id="c17" value="&lt;table style='width:100%;height:100%;border-collapse:collapse;font-size:11px' cellpadding='4'&gt;&lt;tr&gt;&lt;td colspan='2' style='background:#e1d5e7;border-bottom:1px solid #9673a6;text-align:center'&gt;&lt;b style='font-size:13px'&gt;ProgressService&lt;/b&gt; &lt;span style='font-size:10px;color:#555'&gt;«service»&lt;/span&gt;&lt;br&gt;&lt;i style='font-size:10px'&gt;SRP: Update practice progress&lt;/i&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:64%;vertical-align:top;border-right:1px solid #9673a6'&gt;&lt;b&gt;Responsibilities&lt;/b&gt;&lt;ul style='margin:2px 0 0 0;padding-left:14px'&gt;&lt;li&gt;Award XP events and achievements&lt;/li&gt;&lt;li&gt;Update skill mastery from evidence&lt;/li&gt;&lt;li&gt;Keep practice rewards separate from grades&lt;/li&gt;&lt;/ul&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;b&gt;Collaborators&lt;/b&gt;&lt;br&gt;XpEvent&lt;br&gt;SkillProgress&lt;br&gt;Submission&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="html=1;whiteSpace=wrap;overflow=fill;verticalAlign=top;align=left;spacing=0;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;shadow=1;" vertex="1" parent="1"><mxGeometry x="900" y="672" width="400" height="168" as="geometry"/></mxCell><mxCell id="c18" value="&lt;table style='width:100%;height:100%;border-collapse:collapse;font-size:11px' cellpadding='4'&gt;&lt;tr&gt;&lt;td colspan='2' style='background:#ffe6cc;border-bottom:1px solid #d79b00;text-align:center'&gt;&lt;b style='font-size:13px'&gt;AuditLogger&lt;/b&gt; &lt;span style='font-size:10px;color:#555'&gt;«infrastructure»&lt;/span&gt;&lt;br&gt;&lt;i style='font-size:10px'&gt;SRP: Keep an append-only audit trail&lt;/i&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:64%;vertical-align:top;border-right:1px solid #d79b00'&gt;&lt;b&gt;Responsibilities&lt;/b&gt;&lt;ul style='margin:2px 0 0 0;padding-left:14px'&gt;&lt;li&gt;Record score overrides with reason&lt;/li&gt;&lt;li&gt;Record AI outputs and prompt versions&lt;/li&gt;&lt;li&gt;Never update or delete entries&lt;/li&gt;&lt;/ul&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;b&gt;Collaborators&lt;/b&gt;&lt;br&gt;CriterionScore&lt;br&gt;Feedback&lt;br&gt;User&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="html=1;whiteSpace=wrap;overflow=fill;verticalAlign=top;align=left;spacing=0;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1.5;shadow=1;" vertex="1" parent="1"><mxGeometry x="1330" y="672" width="400" height="168" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>