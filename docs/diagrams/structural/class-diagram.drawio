<mxfile host="app.diagrams.net"><diagram id="learnlens-class" name="Class Diagram"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="LearnLens – UML Class Diagram (domain + service layer)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Visibility: + public · - private · # protected · Types follow Django/Python · Multiplicities at both association ends · ◆ composition (lifecycle owned) · ▷ realization · - - ▶ dependency" style="text;html=1;fontSize=12;fontColor=#666666;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1500" height="22" as="geometry"/></mxCell><mxCell id="User" value="&lt;div style='background:#dae8fc;text-align:center;padding:4px 0;border-bottom:1px solid #6c8ebf'&gt;&lt;b&gt;User&lt;/b&gt;&lt;/div&gt;&lt;div style='padding:3px 6px'&gt;- id: int&lt;br&gt;- email: str {unique}&lt;br&gt;- passwordHash: str&lt;br&gt;- fullName: str&lt;br&gt;- isAdmin: bool&lt;br&gt;- isActive: bool&lt;br&gt;- createdAt: datetime&lt;/div&gt;&lt;hr size='1' style='margin:0'&gt;&lt;div style='padding:3px 6px'&gt;+ checkPassword(raw: str): bool&lt;br&gt;+ isEnrolledIn(course: Course): bool&lt;br&gt;+ roleIn(course: Course): Role&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;spacing=0;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="310" height="177" as="geometry"/></mxCell><mxCell id="Enrollment" value="&lt;div style='background:#dae8fc;text-align:center;padding:4px 0;border-bottom:1px solid #6c8ebf'&gt;&lt;b&gt;Enrollment&lt;/b&gt;&lt;/div&gt;&lt;div style='padding:3px 6px'&gt;- id: int&lt;br&gt;- role: Role&lt;br&gt;- joinedAt: datetime&lt;/div&gt;&lt;hr size='1' style='margin:0'&gt;&lt;div style='padding:3px 6px'&gt;+ isStudent(): bool&lt;br&gt;+ isInstructor(): bool&lt;br&gt;+ clean(): void  {section.course = course}&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;spacing=0;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="390" y="120" width="310" height="124" as="geometry"/></mxCell><mxCell id="Course" value="&lt;div style='background:#dae8fc;text-align:center;padding:4px 0;border-bottom:1px solid #6c8ebf'&gt;&lt;b&gt;Course&lt;/b&gt;&lt;/div&gt;&lt;div style='padding:3px 6px'&gt;- id: int&lt;br&gt;- code: str {unique}&lt;br&gt;- title: str&lt;br&gt;- term: str&lt;br&gt;- createdAt: datetime&lt;/div&gt;&lt;hr size='1' style='margin:0'&gt;&lt;div style='padding:3px 6px'&gt;+ publishedAssignments(): list[Assignment]&lt;br&gt;+ addSection(code: str): CourseSection&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;spacing=0;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="740" y="120" width="310" height="137" as="geometry"/></mxCell><mxCell id="CourseSection" value="&lt;div style='background:#dae8fc;text-align:center;padding:4px 0;border-bottom:1px solid #6c8ebf'&gt;&lt;b&gt;CourseSection&lt;/b&gt;&lt;/div&gt;&lt;div style='padding:3px 6px'&gt;- id: int&lt;br&gt;- code: str  {unique per course}&lt;/div&gt;&lt;hr size='1' style='margin:0'&gt;&lt;div style='padding:3px 6px'&gt;+ students(): list[User]&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;spacing=0;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1090" y="120" width="310" height="85" as="geometry"/></mxCell><mxCell id="SkillProgress" value="&lt;div style='background:#dae8fc;text-align:center;padding:4px 0;border-bottom:1px solid #6c8ebf'&gt;&lt;b&gt;SkillProgress&lt;/b&gt;&lt;/div&gt;&lt;div style='padding:3px 6px'&gt;- id: int&lt;br&gt;- masteryLevel: Decimal [0..1]&lt;br&gt;- evidenceCount: int&lt;br&gt;- updatedAt: datetime&lt;/div&gt;&lt;hr size='1' style='margin:0'&gt;&lt;div style='padding:3px 6px'&gt;+ recordEvidence(passed: bool): void&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;spacing=0;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="310" height="111" as="geometry"/></mxCell><mxCell id="Skill" value="&lt;div style='background:#dae8fc;text-align:center;padding:4px 0;border-bottom:1px solid #6c8ebf'&gt;&lt;b&gt;Skill&lt;/b&gt;&lt;/div&gt;&lt;div style='padding:3px 6px'&gt;- id: int&lt;br&gt;- name: str&lt;br&gt;- description: str&lt;/div&gt;&lt;hr size='1' style='margin:0'&gt;&lt;div style='padding:3px 6px'&gt;&amp;nbsp;&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;spacing=0;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="390" y="370" width="310" height="98" as="geometry"/></mxCell><mxCell id="Assignment" value="&lt;div style='background:#dae8fc;text-align:center;padding:4px 0;border-bottom:1px solid #6c8ebf'&gt;&lt;b&gt;Assignment&lt;/b&gt;&lt;/div&gt;&lt;div style='padding:3px 6px'&gt;- id: int&lt;br&gt;- title: str&lt;br&gt;- instructions: str&lt;br&gt;- status: AssignmentStatus&lt;br&gt;- feedbackDepth: FeedbackDepth&lt;br&gt;- dueAt: datetime&lt;br&gt;- publishedAt: datetime [0..1]&lt;br&gt;- createdAt: datetime&lt;/div&gt;&lt;hr size='1' style='margin:0'&gt;&lt;div style='padding:3px 6px'&gt;+ publish(): void&lt;br&gt;+ close(): void&lt;br&gt;+ archive(): void&lt;br&gt;+ acceptsSubmissions(now: datetime): bool&lt;br&gt;+ maxPoints(): Decimal&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;spacing=0;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="740" y="370" width="310" height="217" as="geometry"/></mxCell><mxCell id="RubricCriterion" value="&lt;div style='background:#dae8fc;text-align:center;padding:4px 0;border-bottom:1px solid #6c8ebf'&gt;&lt;b&gt;RubricCriterion&lt;/b&gt;&lt;/div&gt;&lt;div style='padding:3px 6px'&gt;- id: int&lt;br&gt;- title: str&lt;br&gt;- description: str&lt;br&gt;- maxPoints: Decimal&lt;br&gt;- position: int&lt;/div&gt;&lt;hr size='1' style='margin:0'&gt;&lt;div style='padding:3px 6px'&gt;+ testCases(): list[TestCase]&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;spacing=0;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1090" y="370" width="310" height="124" as="geometry"/></mxCell><mxCell id="TestCase" value="&lt;div style='background:#dae8fc;text-align:center;padding:4px 0;border-bottom:1px solid #6c8ebf'&gt;&lt;b&gt;TestCase&lt;/b&gt;&lt;/div&gt;&lt;div style='padding:3px 6px'&gt;- id: int&lt;br&gt;- name: str&lt;br&gt;- visibility: Visibility&lt;br&gt;- stdinInput: str&lt;br&gt;- expectedOutput: str&lt;br&gt;- weight: Decimal&lt;br&gt;- timeLimitMs: int = 2000&lt;/div&gt;&lt;hr size='1' style='margin:0'&gt;&lt;div style='padding:3px 6px'&gt;+ isVisibleTo(user: User): bool&lt;br&gt;+ matches(actual: str): bool&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;spacing=0;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1440" y="370" width="310" height="164" as="geometry"/></mxCell><mxCell id="Submission" value="&lt;div style='background:#dae8fc;text-align:center;padding:4px 0;border-bottom:1px solid #6c8ebf'&gt;&lt;b&gt;Submission&lt;/b&gt;&lt;/div&gt;&lt;div style='padding:3px 6px'&gt;- id: int&lt;br&gt;- attemptNumber: int&lt;br&gt;- language: Language&lt;br&gt;- status: SubmissionStatus&lt;br&gt;- retryCount: int = 0&lt;br&gt;- submittedAt: datetime&lt;/div&gt;&lt;hr size='1' style='margin:0'&gt;&lt;div style='padding:3px 6px'&gt;+ markRunning(): void&lt;br&gt;+ markTested(): void&lt;br&gt;+ markFeedbackReady(): void&lt;br&gt;+ fail(reason: str): void&lt;br&gt;+ totalScore(): Decimal&lt;br&gt;+ previousAttempt(): Submission [0..1]&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;spacing=0;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="740" y="670" width="310" height="203" as="geometry"/></mxCell><mxCell id="CriterionScore" value="&lt;div style='background:#dae8fc;text-align:center;padding:4px 0;border-bottom:1px solid #6c8ebf'&gt;&lt;b&gt;CriterionScore&lt;/b&gt;&lt;/div&gt;&lt;div style='padding:3px 6px'&gt;- id: int&lt;br&gt;- autoPoints: Decimal&lt;br&gt;- finalPoints: Decimal&lt;br&gt;- overriddenBy: User [0..1]&lt;br&gt;- overrideReason: str [0..1]&lt;br&gt;- overriddenAt: datetime [0..1]&lt;/div&gt;&lt;hr size='1' style='margin:0'&gt;&lt;div style='padding:3px 6px'&gt;+ override(points: Decimal, reason: str, by: User): void&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;spacing=0;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1090" y="670" width="310" height="137" as="geometry"/></mxCell><mxCell id="TestResult" value="&lt;div style='background:#dae8fc;text-align:center;padding:4px 0;border-bottom:1px solid #6c8ebf'&gt;&lt;b&gt;TestResult&lt;/b&gt;&lt;/div&gt;&lt;div style='padding:3px 6px'&gt;- id: int&lt;br&gt;- passed: bool&lt;br&gt;- actualOutput: str&lt;br&gt;- errorType: str [0..1]&lt;br&gt;- runtimeMs: int&lt;/div&gt;&lt;hr size='1' style='margin:0'&gt;&lt;div style='padding:3px 6px'&gt;+ isTimeout(): bool&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;spacing=0;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1440" y="670" width="310" height="124" as="geometry"/></mxCell><mxCell id="ReinforcementQuestion" value="&lt;div style='background:#dae8fc;text-align:center;padding:4px 0;border-bottom:1px solid #6c8ebf'&gt;&lt;b&gt;ReinforcementQuestion&lt;/b&gt;&lt;/div&gt;&lt;div style='padding:3px 6px'&gt;- id: int&lt;br&gt;- prompt: str&lt;br&gt;- options: list[str]&lt;br&gt;- correctOption: int&lt;br&gt;- explanation: str&lt;br&gt;- selectedOption: int [0..1]&lt;br&gt;- isCorrect: bool [0..1]&lt;br&gt;- answeredAt: datetime [0..1]&lt;/div&gt;&lt;hr size='1' style='margin:0'&gt;&lt;div style='padding:3px 6px'&gt;+ answer(option: int): bool&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;spacing=0;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="960" width="310" height="164" as="geometry"/></mxCell><mxCell id="SubmissionFile" value="&lt;div style='background:#dae8fc;text-align:center;padding:4px 0;border-bottom:1px solid #6c8ebf'&gt;&lt;b&gt;SubmissionFile&lt;/b&gt;&lt;/div&gt;&lt;div style='padding:3px 6px'&gt;- id: int&lt;br&gt;- path: str&lt;br&gt;- content: str&lt;br&gt;- sizeBytes: int&lt;/div&gt;&lt;hr size='1' style='margin:0'&gt;&lt;div style='padding:3px 6px'&gt;+ extension(): str&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;spacing=0;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="390" y="960" width="310" height="111" as="geometry"/></mxCell><mxCell id="Feedback" value="&lt;div style='background:#dae8fc;text-align:center;padding:4px 0;border-bottom:1px solid #6c8ebf'&gt;&lt;b&gt;Feedback&lt;/b&gt;&lt;/div&gt;&lt;div style='padding:3px 6px'&gt;- id: int&lt;br&gt;- source: FeedbackSource&lt;br&gt;- summary: str&lt;br&gt;- modelName: str [0..1]&lt;br&gt;- promptVersion: str [0..1]&lt;br&gt;- evidenceVersion: str&lt;br&gt;- createdAt: datetime&lt;/div&gt;&lt;hr size='1' style='margin:0'&gt;&lt;div style='padding:3px 6px'&gt;+ strengths(): list[FeedbackItem]&lt;br&gt;+ issues(): list[FeedbackItem]&lt;/div&gt;" s