Color=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1800" y="217" width="200" height="102" as="geometry"/></mxCell><mxCell id="eFD" value="&lt;div style='background:#fff2cc;text-align:center;padding:4px 0;border-bottom:1px solid #6c8ebf'&gt;&lt;span style='font-weight:normal;font-size:10px'&gt;«enumeration»&lt;/span&gt;&lt;br&gt;&lt;b&gt;FeedbackDepth&lt;/b&gt;&lt;/div&gt;&lt;div style='padding:3px 6px'&gt;HINT&lt;br&gt;GUIDED&lt;br&gt;DETAILED&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;spacing=0;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1800" y="341" width="200" height="89" as="geometry"/></mxCell><mxCell id="eVis" value="&lt;div style='background:#fff2cc;text-align:center;padding:4px 0;border-bottom:1px solid #6c8ebf'&gt;&lt;span style='font-weight:normal;font-size:10px'&gt;«enumeration»&lt;/span&gt;&lt;br&gt;&lt;b&gt;Visibility&lt;/b&gt;&lt;/div&gt;&lt;div style='padding:3px 6px'&gt;PUBLIC&lt;br&gt;HIDDEN&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;spacing=0;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1800" y="452" width="200" height="75" as="geometry"/></mxCell><mxCell id="eLang" value="&lt;div style='background:#fff2cc;text-align:center;padding:4px 0;border-bottom:1px solid #6c8ebf'&gt;&lt;span style='font-weight:normal;font-size:10px'&gt;«enumeration»&lt;/span&gt;&lt;br&gt;&lt;b&gt;Language&lt;/b&gt;&lt;/div&gt;&lt;div style='padding:3px 6px'&gt;PYTHON&lt;br&gt;JAVA&lt;br&gt;CPP&lt;br&gt;JAVASCRIPT&lt;br&gt;HTML&lt;br&gt;CSS&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;spacing=0;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1800" y="549" width="200" height="128" as="geometry"/></mxCell><mxCell id="eSS" value="&lt;div style='background:#fff2cc;text-align:center;padding:4px 0;border-bottom:1px solid #6c8e